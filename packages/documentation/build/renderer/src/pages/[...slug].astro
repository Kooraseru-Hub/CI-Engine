---
import {getCollection,render} from 'astro:content';
import PageFrame from '../components/PageFrame.astro';
import PageTitle from '../components/PageTitle.astro';
import EditLink from '../components/EditLink.astro';
import ApiInteractions from '../components/ApiInteractions.astro';
import {buildOutline,routeFor} from '../data/navigation.mjs';
export async function getStaticPaths(){
  const entries=await getCollection('docs');
  const seen=new Set();
  return entries.map(entry=>{
    const slug=routeFor(entry.id);
    if(seen.has(slug))throw Error('Duplicate documentation route: '+slug);
    seen.add(slug);
    return {params:{slug:slug||undefined},props:{entry,entries}};
  });
}
const {entry,entries}=Astro.props;
const {Content,headings}=await render(entry);
Astro.locals.docsPage={title:entry.data.title,id:entry.id,filePath:entry.filePath};
const items=buildOutline(headings);
const toc={items};
---
<PageFrame title={entry.data.title} description={entry.data.description} entries={entries} current={entry.id} toc={toc}>
  <PageTitle title={entry.data.title}/>
  <div class="docs-article"><Content/></div>
  <footer class="docs-article-footer"><EditLink/></footer>
  <ApiInteractions/>
</PageFrame>
