---
interface Props { entries:{name:string,href:string,icon?:string}[]; label:string; tabs?:{label:string,href:string,active?:boolean}[]; description?:string }
const {entries,label,tabs=[],description}=Astro.props;
const localHref=(href:string)=>href.startsWith('/')&&!href.startsWith('//')?import.meta.env.BASE_URL+href.slice(1):href;
const groups=new Map<string,Props['entries']>();
for(const entry of entries){const initial=entry.name[0].toUpperCase();if(!groups.has(initial))groups.set(initial,[]);groups.get(initial)!.push(entry);}
---
{tabs.length>0&&<nav class="MuiTabs-root Tabs-root-tabs" aria-label="Reference categories">{tabs.map(tab=><a href={localHref(tab.href)} aria-current={tab.active?'page':undefined}>{tab.label}</a>)}</nav>}
{description&&<p>{description}</p>}
{[...groups.entries()].map(([initial,items])=><div class="docs-index-group">
  <div class="header"><span class="MuiTypography-root Typography-h2-Typography-root MuiTypography-inherit">{initial}</span><span class="MuiTypography-root Typography-body1-Typography-colorDisabled-Typography-root MuiTypography-inherit">{items.length} {label}</span></div>
  <hr class="MuiDivider-root Divider-root-divider MuiDivider-fullWidth"/>
  <div class="grid">{items.map(item=><span class="container">{item.icon?<img class="icon" src={item.icon} alt="" loading="lazy"/>:<span class="fallbackDot" aria-hidden="true"/>}<a class="MuiTypography-root MuiTypography-inherit MuiLink-root Link-colorInherit-Link-root-textWrapper MuiLink-underlineHover" href={localHref(item.href)}><span class="MuiTypography-root Typography-body1-Typography-root MuiTypography-inherit">{item.name}</span></a></span>)}</div>
</div>)}
<style>
.MuiTabs-root {display:flex;gap:24px;overflow-x:auto;border-bottom:1px solid var(--docs-border);margin-bottom:24px;}
.MuiTabs-root a {white-space:nowrap;color:var(--docs-muted);padding:12px 0;text-decoration:none;}
.MuiTabs-root a[aria-current] {color:var(--docs-heading);border-bottom:2px solid var(--docs-heading);}
.docs-index-group {margin-top:32px;}
.docs-index-group .header {display:flex;align-items:center;gap:16px;background:transparent;}
.docs-index-group .header span:first-child {font-size:24px;font-weight:700;}
.docs-index-group .header span:last-child {color:var(--docs-muted);}
.docs-index-group hr {border:0;border-top:1px solid var(--docs-border);margin:8px 0 16px;}
.docs-index-group .grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px 16px;}
.docs-index-group .container {display:flex;gap:8px;align-items:center;min-width:0;}
.docs-index-group .container a {overflow-wrap:anywhere;color:var(--docs-heading);text-decoration:none;}
.docs-index-group .container a:hover {text-decoration:underline;}
.icon,.fallbackDot {width:20px;height:20px;flex:none;}
.fallbackDot {display:grid;place-items:center;}
.fallbackDot::before {content:'';width:6px;height:6px;background:var(--docs-muted);border-radius:50%;}
@media(max-width:768px){.docs-index-group .grid {grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:420px){.docs-index-group .grid {grid-template-columns:1fr;}}
</style>
