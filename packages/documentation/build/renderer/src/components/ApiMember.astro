---
import ApiIcon from './ApiIcon.astro';
import ApiParameterTable from './ApiParameterTable.astro';
import ApiParameter from './ApiParameter.astro';
import ApiReturns from './ApiReturns.astro';
import ApiReturn from './ApiReturn.astro';
import type { TypeReferences } from './ApiSignature.astro';
import type { Props as IconProps } from './ApiIcon.astro';
import ApiTags from './ApiTags.astro';
import MemberToggleIcon from './MemberToggleIcon.astro';
import {nameParts} from '../data/format-signature.mjs';
import ApiPanelSignature from './ApiPanelSignature.astro';
interface Entry { name: string; type: string; description: string; defaultValue?:string|number|boolean }
interface Props {
  id: string;
  name: string;
  owner?: string;
  kind: IconProps['kind'];
  signature: string;
  description?: string;
  types?: TypeReferences;
  parameters?: Entry[];
  returns?: Entry[];
  values?: { name: string; value: number; description: string }[];
  deprecation?: string;
  deprecated?: boolean;
  metadata?: { label: string; value: string }[];
}
const {
  id, name, owner, kind, signature, description, types, parameters = [], returns = [],
  values = [], deprecation, deprecated = Boolean(deprecation), metadata = [],
} = Astro.props;
const threadLabels: Record<string, string> = { ReadSafe: 'Read Parallel', Safe: 'Write Parallel', LocalSafe: 'Local Safe' };
const badges = metadata.flatMap(({ label, value }) => {
  if (label === 'Thread safety' && threadLabels[value]) return [threadLabels[value]];
  if (label === 'Capabilities' && value && value !== 'None') return ['Capabilities: '+value];
  if (label === 'Simulation access' && value === 'Yes') return ['Simulation Access'];
  return [];
});
const headingName=name.replace(/\(\)$/,"");
const qualified=owner&&['method','event','callback'].includes(kind)&&!signature.slice(0,signature.indexOf('(')<0?signature.length:signature.indexOf('(')).includes(owner+'.')&&!signature.startsWith(owner+':')?owner+(kind==='method'?':':'.')+signature:signature;
---
<div data-api-member={id} data-kind={kind} data-member-name={name} data-member-metadata={JSON.stringify(metadata)} data-deprecated={deprecated ? "" : undefined}>
  <div class="titleSection">
    <div class="titleRow">
      {kind !== 'constructor' && <div class="iconWrapper"><ApiIcon kind={kind}/></div>}
      <span class:list={['MuiTypography-root',deprecated?'Typography-h3-Typography-root-titleDeprecated':'Typography-h3-Typography-root-title','MuiTypography-inherit']} data-member-heading role="heading" aria-level="3">{nameParts(headingName).map((part:string,index:number)=><>{index>0&&<wbr/>}{part}</>)}</span>
    </div>
    {deprecated && <><ApiTags labels={['Deprecated']}/><button class="toggleIcon" type="button" aria-label="Show details" aria-expanded="false" aria-controls={'member-details-'+id}>Show details<MemberToggleIcon/></button></>}
  </div>
  <div class="MuiCollapse-root MuiCollapse-vertical MuiCollapse-entered" id={'member-details-'+id} hidden={deprecated}>
    <div class="MuiCollapse-wrapper MuiCollapse-vertical"><div class="MuiCollapse-wrapperInner MuiCollapse-vertical">
      {badges.length>0 && <div class="section"><ApiTags labels={badges}/></div>}
      {description && <div class="section"><p class="MuiTypography-root Typography-body1-Typography-root-root MuiTypography-inherit MuiTypography-paragraph">{description}</p></div>}
      <div class="section"><div class="MuiTypography-root Typography-body1-Typography-root-signatureContainer MuiTypography-inherit"><ApiPanelSignature signature={qualified} types={types}/></div></div>
      {(deprecation || Astro.slots.has('deprecation')) && <div class="section">{deprecation&&<p>{deprecation}</p>}<slot name="deprecation"/></div>}
      {parameters.length>0&&<ApiParameterTable>{parameters.map(item=><ApiParameter {...item} types={types}/>)}</ApiParameterTable>}
      <slot name="parameters"/>
      {returns.length>0&&<ApiReturns>{returns.map(item=><ApiReturn {...item} types={types}/>)}</ApiReturns>}
      <slot name="returns"/>
      {Astro.slots.has('body')&&<div class="section"><slot name="body"/></div>}
      {Astro.slots.has('description')&&<div class="section"><slot name="description"/></div>}
  {values.length > 0 && <>
    <h4>Items</h4>
    <div class="api-enum-scroll" role="region" aria-label={name + ' items'} tabindex="0">
      <table class="api-enum-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Value</th><th scope="col">Description</th></tr></thead>
        <tbody>{values.map(item => <tr><td><code>{item.name}</code></td><td>{item.value}</td><td>{item.description}</td></tr>)}</tbody>
      </table>
    </div>
  </>}
  {Astro.slots.has('samples') && <>
    <div class="section"><div class="codeSamplesTitleContainer"><span class="MuiTypography-root Typography-subtitle2-Typography-root-codeSamplesTitle MuiTypography-inherit">Code Samples</span></div><div class="singleCodeSampleContainer"><slot name="samples" /></div></div>
  </>}
    </div></div>
  </div>
  <div class="dividerSpacing"><hr class="MuiDivider-root Divider-root-divider MuiDivider-fullWidth"/></div>
</div>
