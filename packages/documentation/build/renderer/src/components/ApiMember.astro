---
import ApiIcon from './ApiIcon.astro';
import ApiSignature from './ApiSignature.astro';
import type { TypeReferences } from './ApiSignature.astro';
import type { Props as IconProps } from './ApiIcon.astro';
import ApiPanelSignature from './ApiPanelSignature.astro';
interface Entry { name: string; type: string; description: string }
interface Props {
  id: string;
  name: string;
  owner?: string;
  kind: IconProps['kind'];
  signature: string;
  description?: string;
  types?: TypeReferences;
  parameters?: Entry[];
  returns?: Entry[];
  values?: { name: string; value: number; description: string }[];
  deprecation?: string;
  deprecated?: boolean;
  metadata?: { label: string; value: string }[];
}
const {
  id, name, owner, kind, signature, description, types, parameters = [], returns = [],
  values = [], deprecation, deprecated = Boolean(deprecation), metadata = [],
} = Astro.props;
const threadLabels: Record<string, string> = { ReadSafe: 'Read Parallel', Safe: 'Write Parallel', LocalSafe: 'Local Safe' };
const badges = metadata.flatMap(({ label, value }) => {
  if (label === 'Thread safety' && threadLabels[value]) return [threadLabels[value]];
  if (label === 'Simulation access' && value === 'Yes') return ['Simulation Access'];
  return [];
});
const qualified=owner&&['method','event','callback'].includes(kind)&&!signature.slice(0,signature.indexOf('(')<0?signature.length:signature.indexOf('(')).includes(owner+'.')&&!signature.startsWith(owner+':')?owner+(kind==='method'?':':'.')+signature:signature;
---
<section class="api-member" data-api-member={id} data-kind={kind} data-member-name={name} data-deprecated={deprecated ? "" : undefined}>
  <span class="api-member-icon-template" hidden>{kind !== 'constructor' && <ApiIcon kind={kind}/>}</span>
  {deprecated && <div class="api-deprecation-controls"><span class="api-member-status">Deprecated</span><button class="api-deprecated-toggle" type="button" aria-expanded="false">Show details</button></div>}
  <div class="api-member-content" hidden={deprecated}>
  {(badges.length > 0) && (
    <div class="api-member-badges">
      {badges.map(label => <span class="api-member-status">{label}</span>)}
    </div>
  )}
  {description && <p>{description}</p>}
  <div class="MuiTypography-root Typography-body1-Typography-root-signatureContainer MuiTypography-inherit"><ApiPanelSignature signature={qualified} types={types}/></div>
  <slot name="body" />
  <slot name="description" />
  {(deprecation || Astro.slots.has('deprecation') || metadata.length > 0) && (
    <details class="api-disclosure">
      <summary>{name} details</summary>
      {deprecation && <p>{deprecation}</p>}
      <slot name="deprecation" />
      {metadata.length > 0 && (
        <dl class="api-member-metadata">
          {metadata.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
        </dl>
      )}
    </details>
  )}
  {[
    { title: 'Parameters', values: parameters },
    { title: 'Returns', values: returns },
  ].filter(group => group.values.length).map(group => <>
    <h4>{group.title}</h4>
    <dl class="api-parameter-list">{group.values.map(item => <div><dt><ApiSignature signature={item.name ? item.name+' : '+item.type : item.type} types={types} memberName={Boolean(item.name)}/></dt><dd>{item.description}</dd></div>)}</dl>
  </>)}
  {values.length > 0 && <>
    <h4>Items</h4>
    <div class="api-enum-scroll" role="region" aria-label={name + ' items'} tabindex="0">
      <table class="api-enum-table">
        <thead><tr><th scope="col">Name</th><th scope="col">Value</th><th scope="col">Description</th></tr></thead>
        <tbody>{values.map(item => <tr><td><code>{item.name}</code></td><td>{item.value}</td><td>{item.description}</td></tr>)}</tbody>
      </table>
    </div>
  </>}
  {Astro.slots.has('samples') && <>
    <h4>Code Samples</h4>
    <slot name="samples" />
  </>}
  </div>
  {deprecated && <template class="api-deprecated-content"></template>}
</section>
