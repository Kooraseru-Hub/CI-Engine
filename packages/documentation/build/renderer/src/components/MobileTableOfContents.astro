---
import DocumentationUtilities from './DocumentationUtilities.astro';
import TocList from './TocList.astro';
import TocController from './TocController.astro';
const {toc}=Astro.props;
---
{toc && <docs-mobile-toc>
  <nav aria-label="On this page">
    <details>
      <summary aria-label="On this page">
        <span class="docs-mobile-toc-label">On this page <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" aria-hidden="true"><path d="m5 3 4 4-4 4"/></svg></span>
        <span class="docs-mobile-toc-current"></span>
        <svg class="docs-compact-toc-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 6h12M9 12h12M9 18h12M3 6h2M3 12h2M3 18h2"/></svg>
      </summary>
      <div class="docs-mobile-toc-dropdown"><TocList items={toc.items}/><DocumentationUtilities/></div>
    </details>
  </nav>
  <TocController/>
</docs-mobile-toc>}
