---
interface Props { member?:string; label?:string }
const {member,label='Feedback'}=Astro.props;
const repository=process.env.GITHUB_REPOSITORY||'';
const configured=process.env.DOCS_FEEDBACK_URL;
const destination=configured ? new URL(configured) : /^[\w.-]+\/[\w.-]+$/.test(repository) ? new URL('https://github.com/'+repository+'/issues/new') : undefined;
if(destination && destination.protocol!=='https:')throw Error('DOCS_FEEDBACK_URL must use HTTPS');
if(destination && !configured){
  destination.searchParams.set('title','Documentation feedback: '+(Astro.locals.docsPage?.title||'Documentation')+(member?' / '+member:''));
  destination.searchParams.set('body','Page: '+Astro.url.pathname+(member?'#'+member:'')+'\n\nFeedback:\n');
}
---
{destination&&<a class="docs-feedback" href={destination.href}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v11H3V10h4Zm0 1 5-8c2 0 3 2 2 5l-.4 2H20a2 2 0 0 1 2 2l-2 7a2 2 0 0 1-2 2H7"/></svg>{label}</a>}
