---
interface Props { type?: 'note' | 'tip' | 'caution' | 'danger'; title?: string }
const {type='note',title}=Astro.props;
const variant={note:'Info',tip:'Success',caution:'Warning',danger:'Error'}[type];
---
<div role="note" aria-label={title || type} data-kind={type} class:list={['docs-alert','MuiPaper-root','MuiPaper-elevation','MuiPaper-rounded','MuiPaper-elevation0','MuiAlert-root','MuiAlert-standard','Typography-smallLabel1-alertContainer','Alert-standard'+variant,'MuiAlert-color'+variant,'MuiAlert-standard'+variant]}>
  <div class="MuiAlert-icon">
    <svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeInherit" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {type==='note' ? <><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 7.5h.01"/></> : type==='tip' ? <><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></> : type==='caution' ? <><path d="M12 3 2 20h20L12 3ZM12 9v4M12 16h.01"/></> : <><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 16h.01"/></>}
    </svg>
  </div>
  <div class="MuiAlert-message"><div class="innerContainer">{title && <strong>{title}</strong>}<slot/></div></div>
</div>
