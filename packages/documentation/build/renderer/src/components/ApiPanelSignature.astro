---
import SignatureName from './SignatureName.astro';
import SignatureType from './SignatureType.astro';
import {parseSignature} from '../data/format-signature.mjs';
import type {TypeReferences} from './ApiSignature.astro';
interface Props {signature:string;types?:TypeReferences}
const {signature,types={}}=Astro.props;
const parsed=parseSignature(signature);
const args=parsed.args.map(value=>{const match=value.match(/^(.*?)\s*:\s*(.*)$/);return match?{name:match[1],type:match[2]}:{name:'',type:value};});
const multi=parsed.callable&&args.length>1;
---
{multi?<div class="multilineSignature"><div><SignatureName name={parsed.name}/><span class="parentheses">(</span></div><div class="parametersContainer">{args.map((arg,index)=><>{index>0?', ':''}{arg.name&&<><SignatureName name={arg.name}/><span class="spaceSuffixedColonWrapper">:</span></>}<SignatureType type={arg.type} types={types}/></>)}</div><div><span class="parenthesesInnerSpace">)</span>{parsed.returns&&<><span class="spaceSuffixedColonWrapper">:</span><SignatureType type={parsed.returns} types={types} returns/></>}</div></div>:<><SignatureName name={parsed.name}/>{parsed.callable&&<><span class="parentheses">(</span>{args.map(arg=><>{arg.name&&<><SignatureName name={arg.name}/><span class="spaceSuffixedColonWrapper">:</span></>}<SignatureType type={arg.type} types={types}/></>)}<span class="parenthesesInnerSpace">)</span></>}{parsed.returns&&<><span class="spaceSuffixedColonWrapper">:</span><SignatureType type={parsed.returns} types={types} returns={parsed.callable}/></>}</>}