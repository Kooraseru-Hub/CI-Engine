---
import LZString from 'lz-string';
interface Props { code:string; title?:string; description?:string }
const {code,title='Luau Playground',description}=Astro.props;
const state=LZString.compressToEncodedURIComponent(JSON.stringify({v:1,files:{'main.luau':code},active:'main.luau'}));
const url='https://play.luau.org/?embed=true&theme=dark&controls=icons#'+state;
const height=Math.max(230,Math.min(660,Math.ceil(code.trimEnd().split('\n').length*19.6+154)));
---
<div class="docs-playground-sample">
  <h5 class="MuiTypography-root Typography-subtitle2-Typography-root MuiTypography-inherit">{title}</h5>
  {description&&<p class="MuiTypography-root Typography-body1-Typography-root-root MuiTypography-inherit MuiTypography-paragraph">{description}</p>}
  <iframe class="docs-luau-playground" title={'Luau Playground: '+title} src={url} height={height} loading="lazy" allow="clipboard-write" referrerpolicy="no-referrer"></iframe>
</div>
