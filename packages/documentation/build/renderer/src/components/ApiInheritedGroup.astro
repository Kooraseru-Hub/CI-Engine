---
interface Props { id: string; name: string; href: string; count: number }
const {id,name,href,count}=Astro.props;
---
<div class="MuiPaper-root MuiPaper-elevation MuiPaper-rounded MuiPaper-elevation1 MuiAccordion-root Accordion-root-accordionGroup MuiAccordion-rounded" data-inherited-group>
  <div class="MuiButtonBase-root MuiAccordionSummary-root Typography-largeLabel1-summary">
    <div class="MuiAccordionSummary-content AccordionSummary-content">
      <span class="MuiTypography-root Typography-body2-Typography-root-inheritedGroupTitle MuiTypography-inherit">{count} inherited from <a class="MuiTypography-root MuiTypography-inherit MuiLink-root Link-colorPrimary-Link-root-titleLink MuiLink-underlineHover" href={href}>{name}</a></span>
    </div>
    <button type="button" class="MuiAccordionSummary-expandIconWrapper" aria-label={'Show members inherited from '+name} aria-expanded="false" aria-controls={id}>
      <svg class="MuiSvgIcon-root MuiSvgIcon-fontSizeMedium" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6 1.41-1.41L17.83 12l-7.42 7.41z"/></svg>
    </button>
  </div>
  <div class="MuiCollapse-root MuiCollapse-vertical" id={id} hidden>
    <div class="MuiCollapse-wrapper MuiCollapse-vertical"><div class="MuiCollapse-wrapperInner MuiCollapse-vertical">
      <div class="MuiAccordionDetails-root"><slot/></div>
    </div></div>
  </div>
</div>
<script>
  for(const group of document.querySelectorAll<HTMLElement>('[data-inherited-group]')){
    const row=group.querySelector<HTMLElement>('.MuiAccordionSummary-root');
    const control=group.querySelector<HTMLButtonElement>('.MuiAccordionSummary-expandIconWrapper');
    const panel=group.querySelector<HTMLElement>('.MuiCollapse-root');
    if(!row||!control||!panel)continue;
    const toggle=()=>{
      const expanded=control.getAttribute('aria-expanded')==='true';
      control.setAttribute('aria-expanded',String(!expanded));
      panel.hidden=expanded;
    };
    control.addEventListener('click',toggle);
    row.addEventListener('click',event=>{
      if(event.target instanceof Element && !event.target.closest('a,button'))toggle();
    });
  }
</script>
