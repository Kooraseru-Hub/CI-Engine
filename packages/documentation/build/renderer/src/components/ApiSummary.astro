---
import ApiIcon from './ApiIcon.astro';
import ApiTags from './ApiTags.astro';
import SignatureType from './SignatureType.astro';
import {parseSignature} from '../data/format-signature.mjs';
import type { TypeReferences } from './ApiSignature.astro';
import type { Props as IconProps } from './ApiIcon.astro';
interface Member { kind: IconProps['kind']; signature: string; href: string; description?: string; deprecated?: boolean }
interface Props { members: Member[]; types?: TypeReferences; descriptions?: boolean }
const { members, types, descriptions = false } = Astro.props;
---
<div class="MuiGrid-root Grid-root-tableContainer" data-api-summary>
  <table class="MuiTable-root table"><tbody class="MuiTableBody-root">
    {members.map(member=>{
      const parsed=parseSignature(member.signature);
      return <tr class="MuiTableRow-root TableRow-root-tableRow" data-kind={member.kind}>
        <td class="MuiTableCell-root TableCell-root MuiTableCell-body MuiTableCell-sizeMedium">
          <div class="cellContent">
            {member.kind!=='constructor'&&<div class="iconWrapper"><ApiIcon kind={member.kind}/></div>}
            <span class:list={['MuiTypography-root',member.deprecated?'Typography-body2-Typography-root-deprecatedMemberText':'Typography-body2-Typography-root-memberText','MuiTypography-inherit']}>
              <a class="MuiTypography-root MuiTypography-body1 MuiLink-root Link-colorPrimary-Link-root-titleLink MuiLink-underlineHover" href={member.href}>{parsed.name}</a>{parsed.callable&&<span class="parameters">({parsed.args.map((arg,i)=>{const match=arg.match(/^(.*?)\s*:\s*(.*)$/);return <span class="parameter">{match?<>{match[1]}: <SignatureType type={match[2]} types={types}/></>:arg}{i<parsed.args.length-1&&<span class="parameterComma">,</span>}</span>;})})</span>}{parsed.returns&&(parsed.callable?<span><span class="spaceSuffixedColonWrapper">:</span><SignatureType type={parsed.returns} types={types} returns/></span>:<><span class="spaceSuffixedColonWrapper">:</span><SignatureType type={parsed.returns} types={types}/></>)}
            </span>
            {member.deprecated&&<span><ApiTags labels={['Deprecated']}/></span>}
          </div>
          {descriptions&&member.description&&<span class="api-description">{member.description}</span>}
        </td>
      </tr>;
    })}
  </tbody></table>
</div>
