---
const base=import.meta.env.BASE_URL;
---
<div class="docs-search" data-base={base}>
  <button class="docs-search-open" type="button" aria-haspopup="dialog"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg>Search <kbd>Ctrl K</kbd></button>
  <dialog aria-label="Search documentation"><form method="dialog"><button type="submit" aria-label="Close search">×</button></form><input type="search" aria-label="Search documentation" placeholder="Search documentation"/><p role="status"></p><ul></ul></dialog>
</div>
<script>
const wrapper=document.querySelector<HTMLElement>('.docs-search');
if(wrapper){
  const dialog=wrapper.querySelector('dialog')!,input=wrapper.querySelector('input')!,status=wrapper.querySelector('p')!,list=wrapper.querySelector('ul')!;
  const base=wrapper.dataset.base||'/';
  const open=()=>{if(!dialog.open)dialog.showModal();input.focus();};
  wrapper.querySelector('button')?.addEventListener('click',open);
  addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();open();}});
  let sequence=0;
  input.addEventListener('input',async()=>{
    const query=input.value.trim(),request=++sequence;list.replaceChildren();if(!query){status.textContent='';return;}
    status.textContent='Searching…';
    try{
      const index=await import(/* @vite-ignore */ base+'pagefind/pagefind.js');
      const search=await index.search(query);
      const results=await Promise.all(search.results.slice(0,15).map((r:any)=>r.data()));
      if(request!==sequence)return;
      status.textContent=results.length?'':'No results';
      for(const result of results){
        const li=document.createElement('li'),a=document.createElement('a');
        const url=new URL(result.url,location.origin);
        if(url.origin!==location.origin)continue;
        a.href=url.pathname.startsWith(base)?url.pathname+url.hash:base+url.pathname.replace(/^\//,'')+url.hash;
        a.textContent=result.meta.title||result.url;li.append(a);list.append(li);
      }
    }catch{if(request===sequence)status.textContent='Search index unavailable.';}
  });
}
</script>
