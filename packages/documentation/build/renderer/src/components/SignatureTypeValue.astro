---
import builtins from '../data/luau-types.json';
import {normalizeType} from '../data/format-signature.mjs';
import type {TypeReferences} from './ApiSignature.astro';
interface Props {type:string;types?:TypeReferences;}
const {type,types={}}=Astro.props;
const refs={...builtins,...types};
const value=normalizeType(type,refs);
const key=value.replace(/^Enum\./,'').replace(/\?$/,'');
const info=refs[key] as TypeReferences[string]|undefined;
const classes='MuiTypography-root dashedType Typography-body2-Typography-root-parameterType MuiTypography-inherit';
---
<span><span class="parameterType-dashedTypeWrapper"><span>{info?.href?<a class="MuiTypography-root MuiTypography-inherit MuiLink-root Link-colorPrimary-Link-root MuiLink-underlineHover" href={info.href} data-api-type={key} data-category={info.category} data-description={info.description}><span class={classes} aria-label="parameter type" aria-roledescription="tooltip">{value}</span></a>:info?<span tabindex="0" data-api-type={key} data-category={info.category} data-description={info.description} class={classes}>{value}</span>:<span class={classes}>{value}</span>}</span></span></span>
