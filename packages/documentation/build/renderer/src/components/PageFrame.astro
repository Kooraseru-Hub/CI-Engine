---
import Sidebar from './Sidebar.astro';
import TableOfContents from './TableOfContents.astro';
import MobileTableOfContents from './MobileTableOfContents.astro';
import DocsSearch from './DocsSearch.astro';
import '../styles/theme/fallback.css';
import '../styles/layout.css';
import '../styles/typography.css';
import '../styles/navigation.css';
import '../styles/reference.css';
import '../styles/project.css';
import '../styles/theme/forced-colors.css';
const {title:pageTitle,description,entries,current,toc}=Astro.props;
const repository=process.env.GITHUB_REPOSITORY||'';
const title=process.env.DOCS_TITLE||repository.split('/').at(-1)||'Documentation';
const home=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme="dark" data-has-sidebar data-has-toc>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{pageTitle} | {title}</title>
{description&&<meta name="description" content={description}/>}
<link rel="icon" href={home+"images/favicon.png"}/>
</head>
<body>
<aside class="docs-project-rail print:hidden" aria-label="Project navigation">
  <a class="docs-project-brand" href={home}><img src={home+'images/favicon.png'} width="24" height="24" alt=""/><span>{title}</span></a>
  <nav aria-label="Project sections">
    <a href={home} class="docs-project-link" aria-current="page"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 6c-3-2-6-2-9-1v14c3-1 6-1 9 1 3-2 6-2 9-1V5c-3-1-6-1-9 1zm0 0v14"/></svg><span>Documentation</span></a>
    {repository&&<a href={'https://github.com/'+repository} class="docs-project-link"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-15-2 18"/></svg><span>Source repository</span></a>}
  </nav>
  <button type="button" class="docs-project-toggle" aria-label="Hide project sidebar" aria-expanded="true"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M9 5v14"/></svg><span>Hide sidebar</span></button>
</aside>
<header class="docs-header">
  <button class="docs-menu-toggle" aria-label="Toggle documentation navigation" aria-controls="docs-sidebar" aria-expanded="false" type="button">☰</button>
  <DocsSearch/>
  {repository&&<a class="docs-header-source" href={'https://github.com/'+repository} aria-label="Source repository"><svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.36-1.18-3.36-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.6 9.6 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg></a>}
</header>
<aside id="docs-sidebar" class="sidebar-pane"><Sidebar entries={entries} current={current}/></aside>
<div class="main-frame">
  <main id="main" data-pagefind-body><slot/></main>
  <aside class="right-sidebar"><div class="right-sidebar-panel"><TableOfContents toc={toc}/></div></aside>
</div>
<MobileTableOfContents toc={toc}/>
</body>
</html>
<script>
  const menu=document.querySelector<HTMLButtonElement>('.docs-menu-toggle');
  menu?.addEventListener('click',()=>{const open=document.documentElement.toggleAttribute('data-menu-open');menu.setAttribute('aria-expanded',String(open));});
  addEventListener('keydown',event=>{if(event.key==='Escape'){document.documentElement.removeAttribute('data-menu-open');menu?.setAttribute('aria-expanded','false');}});
  const button=document.querySelector<HTMLButtonElement>('.docs-project-toggle');
  if(button)button.addEventListener('click',()=>{
    const hidden=document.documentElement.toggleAttribute('data-project-rail-collapsed');
    button.setAttribute('aria-expanded',String(!hidden));
    button.setAttribute('aria-label',hidden?'Show project sidebar':'Hide project sidebar');
    const label=button.querySelector('span');if(label)label.textContent=hidden?'Show sidebar':'Hide sidebar';
  });
</script>
