{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI Engine configuration",
  "type": "object",
  "required": [
    "version",
    "triggers",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "componentRoot": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_./-]+$",
      "description": "Repository-relative directory containing tracked component.json files"
    },
    "triggers": {
      "type": "object",
      "description": "GitHub event name mapped to operation name",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "mode",
          "events"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "readonly",
              "generated",
              "protected"
            ]
          },
          "events": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "branch": {
            "enum": [
              "default"
            ]
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          },
          "environment": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "publication": {
            "type": "boolean"
          },
          "plan": {
            "type": "string",
            "minLength": 1
          },
          "branchPrefix": {
            "type": "string",
            "minLength": 2
          },
          "execution": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "profile": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "native": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "readonly"
                }
              }
            },
            "then": {
              "required": [
                "components"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "generated"
                }
              }
            },
            "then": {
              "required": [
                "environment",
                "plan",
                "branchPrefix",
                "publication",
                "execution"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "protected"
                }
              }
            },
            "then": {
              "required": [
                "components",
                "environment"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "execution"
                    ]
                  },
                  {
                    "required": [
                      "native"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
