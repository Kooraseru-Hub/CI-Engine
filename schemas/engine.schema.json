{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI Engine configuration",
  "type": "object",
  "required": [
    "version",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "componentRoot": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_./-]+$",
      "description": "Repository-relative directory containing tracked component.json files"
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "mode",
          "events"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "readonly",
              "staged"
            ]
          },
          "events": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "branch": {
            "enum": [
              "default"
            ]
          },
          "extensions": {
            "type": "object",
            "additionalProperties": true
          },
          "publication": {
            "type": "boolean"
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hostTests": {
            "type": "object",
            "required": [
              "command",
              "artifactPath"
            ],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "artifactPath": {
                "type": "string",
                "pattern": "^build/[a-zA-Z0-9_./-]+$"
              }
            },
            "additionalProperties": false
          },
          "delivery": {
            "type": "object",
            "required": [
              "command"
            ],
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "readonly"
                }
              }
            },
            "then": {
              "required": [
                "components"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "mode": {
                  "const": "staged"
                }
              }
            },
            "then": {
              "required": [
                "publication",
                "components",
                "delivery"
              ],
              "properties": {
                "publication": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
